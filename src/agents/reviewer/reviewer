#!/usr/bin/env python3
# -*- coding: utf-8 -*-

"""
DeepSeek 驱动的通用市场分析报告规范化与纠错智能体（修复版）
修复：图片提取错误，支持任意行业 DOCX 报告
"""

import os
import re
import argparse
import tempfile
from typing import List, Tuple, Optional
from docx import Document
from docx.shared import Pt, Cm, Inches
from docx.enum.text import WD_ALIGN_PARAGRAPH
from docx.oxml.ns import qn
from docx.oxml import OxmlElement
import requests

# ==================== 配置 ====================
DEEPSEEK_API_URL = "https://api.deepseek.com/v1/chat/completions"
DEEPSEEK_MODEL = "deepseek-chat"
# =============================================

class UniversalReportBeautifier:
    """通用市场分析报告规范化与纠错智能体（修复版）"""

    def __init__(self, api_key: str):
        self.api_key = api_key
        self.headers = {
            "Authorization": f"Bearer {api_key}",
            "Content-Type": "application/json"
        }

    # ------------------- 提取文本和图片（修复版）-------------------
    def extract_text_and_images(self, docx_path: str) -> Tuple[str, List[bytes], str]:
        """
        提取 DOCX 中的纯文本、所有图片二进制数据、自动识别的报告标题
        修复：使用 doc.inline_shapes 直接获取图片，不再依赖段落属性
        """
        doc = Document(docx_path)
        
        # 提取所有段落的文本（忽略空行）
        paragraphs = []
        for para in doc.paragraphs:
            text = para.text.strip()
            if text:
                paragraphs.append(text)
        
        # 提取所有内联图片（InlineShape）
        images = []
        for inline in doc.inline_shapes:
            try:
                # 获取图片的二进制数据
                blip = inline._inline.graphic.graphicData.pic.blipFill.blip
                embed_id = blip.embed
                part = doc.part.related_parts[embed_id]
                images.append(part.blob)
            except Exception:
                # 如果获取失败，跳过该图片
                continue
        
        # 如果通过 inline_shapes 没取到图片，尝试另一种方式（遍历 runs）
        if not images:
            for para in doc.paragraphs:
                for run in para.runs:
                    # 检查 run 中是否包含图片（blip 元素）
                    blips = run.element.xpath('.//a:blip')
                    if blips:
                        for blip in blips:
                            embed_id = blip.get(qn('r:embed'))
                            if embed_id:
                                part = doc.part.related_parts[embed_id]
                                images.append(part.blob)
        
        full_text = "\n".join(paragraphs)
        
        # 自动识别报告标题
        title = "产品市场分析报告"  # 默认
        if paragraphs:
            first_line = paragraphs[0]
            # 如果第一行长度合适且包含关键词，作为标题
            if len(first_line) <= 60 and ('报告' in first_line or '分析' in first_line):
                title = first_line
            else:
                # 取前几个字作为产品名
                product_name = first_line[:30] if len(first_line) > 30 else first_line
                title = f"{product_name} 市场分析报告"
        
        return full_text, images, title

    # ------------------- 调用 API -------------------
    def build_system_prompt(self) -> str:
        return """
你是【通用市场分析报告规范化与纠错智能体】。你必须严格遵守以下规则，输出规范化后的报告纯文本。

## 排版规范
1. **一级标题**：使用“一、”“二、”“三、”……（后跟标题内容）
2. **二级标题**：使用“1.1”“1.2”“2.1”……（后跟标题内容）
3. **三级标题**：使用“1.1.1”“1.1.2”……（后跟标题内容）
4. **正文段落**：每段首行缩进2个字符（在文本中使用两个全角空格“　　”表示缩进）
5. **表格**：使用标准 Markdown 表格格式
6. **图表标题**：单独一行，格式如“图1 xxx”、“表1 xxx”
7. **删除噪音**：多余空行（最多保留一个空行）、乱码
8. **标点符号**：统一中文全角标点

## 内容纠错
- 修正数据矛盾（如前后市占率不一致）
- 删除跨行业错误（例如水果报告不能出现“耳机”“蓝牙”等无关术语）
- 统一产品定位、目标用户、核心卖点
- 保留原始核心结论与建议

## 输出要求
- 只输出最终报告正文（纯文本格式），不输出任何额外解释
- 语言简体中文，正式专业
- 报告末尾加一行“--- 报告完 ---”
"""

    def build_user_prompt(self, raw_text: str) -> str:
        return f"原始报告文本：\n{raw_text}"

    def call_deepseek(self, system_prompt: str, user_prompt: str) -> str:
        payload = {
            "model": DEEPSEEK_MODEL,
            "messages": [
                {"role": "system", "content": system_prompt},
                {"role": "user", "content": user_prompt}
            ],
            "temperature": 0.1,
            "max_tokens": 30000,
            "top_p": 0.9
        }
        try:
            resp = requests.post(DEEPSEEK_API_URL, headers=self.headers, json=payload, timeout=120)
            resp.raise_for_status()
            result = resp.json()
            return result["choices"][0]["message"]["content"]
        except Exception as e:
            raise RuntimeError(f"DeepSeek API 调用失败: {e}")

    # ------------------- 解析 Markdown 表格 -------------------
    def parse_markdown_table(self, lines: List[str], start_idx: int) -> Tuple[List[List[str]], int]:
        table_data = []
        table_lines = []
        i = start_idx
        while i < len(lines) and '|' in lines[i]:
            table_lines.append(lines[i].strip())
            i += 1
        if len(table_lines) < 2:
            return [], start_idx
        header = [cell.strip() for cell in table_lines[0].split('|') if cell.strip() != '']
        table_data.append(header)
        for line in table_lines[2:]:
            row = [cell.strip() for cell in line.split('|') if cell.strip() != '']
            if row:
                table_data.append(row)
        return table_data, i

    # ------------------- DOCX 构建 -------------------
    def add_paragraph_with_indent(self, doc, text: str):
        para = doc.add_paragraph()
        run = para.add_run(text)
        para.paragraph_format.first_line_indent = Cm(0.7)
        para.paragraph_format.line_spacing = 1.5
        run.font.name = '宋体'
        run._element.rPr.rFonts.set(qn('w:eastAsia'), '宋体')
        run.font.size = Pt(12)

    def add_heading(self, doc, text: str, level: int, add_page_break_before: bool = False):
        if add_page_break_before:
            doc.add_page_break()
        para = doc.add_heading(text, level=level)
        para.paragraph_format.space_before = Pt(12)
        para.paragraph_format.space_after = Pt(6)
        for run in para.runs:
            run.font.name = '黑体' if level <= 2 else '宋体'
            run._element.rPr.rFonts.set(qn('w:eastAsia'), '黑体' if level <= 2 else '宋体')
            if level == 1:
                run.font.size = Pt(18)
            elif level == 2:
                run.font.size = Pt(16)
            else:
                run.font.size = Pt(14)

    def add_table_to_doc(self, doc, table_data: List[List[str]]):
        if not table_data:
            return
        rows = len(table_data)
        cols = len(table_data[0])
        table = doc.add_table(rows=rows, cols=cols)
        table.style = 'Light Grid Accent 1'
        for i, row in enumerate(table_data):
            for j, cell_text in enumerate(row):
                cell = table.cell(i, j)
                cell.text = cell_text
                para = cell.paragraphs[0]
                for run in para.runs:
                    run.font.name = '宋体'
                    run._element.rPr.rFonts.set(qn('w:eastAsia'), '宋体')
                    run.font.size = Pt(11)
        doc.add_paragraph()

    def add_cover_page(self, doc, title: str):
        """通用封面"""
        para = doc.add_paragraph()
        para.alignment = WD_ALIGN_PARAGRAPH.CENTER
        run = para.add_run(title)
        run.font.size = Pt(28)
        run.font.bold = True
        run.font.name = '黑体'
        run._element.rPr.rFonts.set(qn('w:eastAsia'), '黑体')
        para.paragraph_format.space_before = Cm(5)
        para.paragraph_format.space_after = Cm(5)

        info_lines = [
            "报告类别：行业研究报告",
            "报告日期：2025年12月",
            "报告编号：MAR-2025-001",
            "",
            "*本报告为内部机密文件，仅供授权人员阅读*"
        ]
        for line in info_lines:
            para = doc.add_paragraph()
            para.alignment = WD_ALIGN_PARAGRAPH.CENTER
            run = para.add_run(line)
            run.font.size = Pt(14)
            run.font.name = '宋体'
            run._element.rPr.rFonts.set(qn('w:eastAsia'), '宋体')
        doc.add_page_break()

    def add_toc(self, doc):
        """插入 Word 目录域"""
        para = doc.add_paragraph("目 录")
        para.alignment = WD_ALIGN_PARAGRAPH.CENTER
        run = para.runs[0]
        run.font.size = Pt(18)
        run.font.bold = True
        run.font.name = '黑体'
        run._element.rPr.rFonts.set(qn('w:eastAsia'), '黑体')
        toc_para = doc.add_paragraph()
        toc_para.alignment = WD_ALIGN_PARAGRAPH.LEFT
        run = toc_para.add_run()
        fldChar = OxmlElement('w:fldChar')
        fldChar.set(qn('w:fldCharType'), 'begin')
        run._r.append(fldChar)
        instrText = OxmlElement('w:instrText')
        instrText.text = 'TOC \\o "1-3" \\h \\z \\u'
        run._r.append(instrText)
        fldChar = OxmlElement('w:fldChar')
        fldChar.set(qn('w:fldCharType'), 'end')
        run._r.append(fldChar)
        doc.add_page_break()

    def build_docx_from_text(self, polished_text: str, output_path: str, 
                             original_images: List[bytes], report_title: str):
        """从规范文本构建最终 DOCX（图片按图表标题顺序插入）"""
        doc = Document()
        self.add_cover_page(doc, report_title)
        self.add_toc(doc)

        lines = polished_text.splitlines()
        i = 0
        img_pointer = 0

        while i < len(lines):
            line = lines[i].strip()
            if not line:
                i += 1
                continue

            # 表格
            if line.startswith('|') and '|' in line:
                table_data, next_i = self.parse_markdown_table(lines, i)
                if table_data:
                    self.add_table_to_doc(doc, table_data)
                    i = next_i
                    continue

            # 一级标题（分页）
            if re.match(r'^[一二三四五六七八九十]+、', line):
                if i > 0:
                    doc.add_page_break()
                self.add_heading(doc, line, level=1)
                i += 1
                continue

            # 二级标题
            if re.match(r'^\d+\.\d+\s+', line) or re.match(r'^\d+\.\d+$', line):
                self.add_heading(doc, line, level=2)
                i += 1
                continue

            # 三级标题
            if re.match(r'^\d+\.\d+\.\d+\s+', line) or re.match(r'^\d+\.\d+\.\d+$', line):
                self.add_heading(doc, line, level=3)
                i += 1
                continue

            # 图表标题（如“图1 xxx”、“表1 xxx”）
            chart_match = re.match(r'^(图|表)\d+\s*[：]?\s*\S', line)
            if chart_match:
                # 添加标题文字（居中加粗）
                para = doc.add_paragraph()
                para.alignment = WD_ALIGN_PARAGRAPH.CENTER
                run = para.add_run(line)
                run.bold = True
                run.font.size = Pt(11)
                run.font.name = '宋体'
                run._element.rPr.rFonts.set(qn('w:eastAsia'), '宋体')
                # 尝试插入对应的图片
                if img_pointer < len(original_images):
                    img_bytes = original_images[img_pointer]
                    with tempfile.NamedTemporaryFile(suffix='.png', delete=False) as tmp:
                        tmp.write(img_bytes)
                        tmp_path = tmp.name
                    try:
                        doc.add_picture(tmp_path, width=Inches(5.5))
                    finally:
                        os.unlink(tmp_path)
                    img_pointer += 1
                else:
                    doc.add_paragraph("（原图缺失）")
                i += 1
                continue

            # 普通正文
            self.add_paragraph_with_indent(doc, line)
            i += 1

        doc.save(output_path)

    # ------------------- 主流程 -------------------
    def beautify_report(self, input_path: str, output_path: Optional[str] = None) -> str:
        print(f"[1/5] 读取原始报告: {input_path}")
        raw_text, images, report_title = self.extract_text_and_images(input_path)
        if not raw_text.strip():
            raise ValueError("文件内容为空或无法提取文本")
        print(f"     图片数量: {len(images)}")
        print(f"     自动识别标题: {report_title}")

        print("[2/5] 调用 DeepSeek API 进行规范化与纠错...")
        system_prompt = self.build_system_prompt()
        user_prompt = self.build_user_prompt(raw_text)
        polished_text = self.call_deepseek(system_prompt, user_prompt)

        if output_path is None:
            base, ext = os.path.splitext(input_path)
            output_path = f"{base}_规范版.docx"

        print("[3/5] 生成最终 DOCX（封面、目录、分页、图片保留）...")
        self.build_docx_from_text(polished_text, output_path, images, report_title)

        # 备份文本
        txt_path = output_path.replace(".docx", ".txt")
        with open(txt_path, "w", encoding="utf-8") as f:
            f.write(polished_text)
        print(f"[4/5] 文本备份已保存: {txt_path}")
        print(f"[5/5] ✅ 规范报告已生成: {output_path}")
        print("\n⚠️ 提示：请打开 Word 文档，选中目录区域后按 F9 更新目录。")
        return output_path


def main():
    parser = argparse.ArgumentParser(description="通用市场分析报告规范化与纠错智能体（修复版）")
    parser.add_argument("input", help="输入的 DOCX 文件路径")
    parser.add_argument("-o", "--output", help="输出的 DOCX 文件路径（可选）")
    parser.add_argument("--api-key", help="DeepSeek API Key，也可设置环境变量 DEEPSEEK_API_KEY")
    args = parser.parse_args()

    api_key = args.api_key or os.environ.get("DEEPSEEK_API_KEY")
    if not api_key:
        print("错误：请提供 DeepSeek API Key（--api-key 或环境变量 DEEPSEEK_API_KEY）")
        return 1

    try:
        agent = UniversalReportBeautifier(api_key)
        out_path = agent.beautify_report(args.input, args.output)
        print(f"✅ 成功生成规范报告: {out_path}")
    except Exception as e:
        print(f"❌ 处理失败: {e}")
        import traceback
        traceback.print_exc()
        return 1
    return 0


if __name__ == "__main__":
    exit(main())
